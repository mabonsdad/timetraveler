# Copy to .env (which git ignores) and fill in. See SECRETS.md.

# fal.ai - dashboard -> Keys
FAL_KEY=

# Google AI Studio - Get API key
GEMINI_API_KEY=

# Stop any single command once its estimated spend passes this many US dollars
HSVIS_AI_BUDGET=5

